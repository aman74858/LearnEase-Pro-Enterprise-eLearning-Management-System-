{
  "name": "learnease-pro",
  "version": "1.0.0",
  "description": "LearnEase Pro — Full-Stack eLearning Management System (MERN)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run server:dev\" \"npm run client\"",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "build:client": "cd client && npm run build"
  },
  "keywords": [
    "mern",
    "elearning",
    "lms",
    "react",
    "mongodb",
    "express",
    "node",
    "socketio",
    "tailwindcss"
  ],
  "author": "LearnEase Pro Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
